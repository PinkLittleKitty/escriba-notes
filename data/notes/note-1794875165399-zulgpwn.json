  "content": "<div class=\"code-block-container\" contenteditable=\"false\" data-code=\"I'm stuck on how to do part 2.\n\nThis is what I've done for now: &quot;import java.util.List;\n\nabstract class Dependencia {\n    private String nombre;\n\n    public Dependencia(String nombre) {\n        this.nombre = nombre;\n    }\n\n    abstract double costo();\n}\n\nclass Oficina extends Dependencia {\n    public Oficina(String nombre) {\n        super(nombre);\n    }\n\n    private List&lt;Empleado&gt; empleados;\n\n    @Override\n    public double costo() {\n        return gastoLimpieza() + gastoEnergia() + gastoEmpleados();\n    }\n\n    private double gastoLimpieza() {\n        return 100.0;\n    }\n\n    private double gastoEnergia() {\n        return 200.0;\n    }\n\n    private double gastoEmpleados() {\n        return empleados.stream().mapToDouble(Empleado::salario).sum();\n    }\n\n    public void agregarEmpleado(Empleado empleado) {\n        empleados.add(empleado);\n    }\n\n    public List&lt;Empleado&gt; getEmpleados() {\n        return empleados;\n    }\n}\n\nclass Departamento extends Dependencia {\n    private List&lt;Dependencia&gt; dependencias;\n    private List&lt;GastosDepartamentales&gt; gastosDepartamentales;\n    \n    public Departamento(String nombre, List&lt;Dependencia&gt; dependencias) {\n        super(nombre);\n        this.dependencias = dependencias;\n    }\n\n    @Override\n    public double costo() {\n        return costoDependencias() + gastosDepartamentales();\n    }\n\n    public double costoDependencias() {\n        return dependencias.stream().mapToDouble(Dependencia::costo).sum();\n    }\n\n    public double gastosDepartamentales() {\n        return gastosDepartamentales.stream().mapToDouble(GastosDepartamentales::pagar).sum();\n    }\n\n    public void agregarGastoDepartamental(GastosDepartamentales g) {\n        gastosDepartamentales.add(g);\n    }\n}\n\n\nclass Empleado {\n    private String nombre;\n    private String edad;\n    private Double precioBase;\n    private Double porcentajeAportes;\n\n    public Empleado(String nombre, String edad, Double precioBase, Double porcentajeAportes) {\n        this.nombre = nombre;\n        this.edad = edad;\n        this.precioBase = precioBase;\n        this.porcentajeAportes = porcentajeAportes;\n    }\n\n    public double salario() {\n        return precioBase; //TODO: No entiendo la consigna\n    }\n}\n\nclass GastosDepartamentales {\n    private double valor;\n    private String concepto;\n    private FormaDePago formaDePago;\n\n    public GastosDepartamentales(double valor, String concepto, FormaDePago formaDePago) {\n        this.valor = valor;\n        this. concepto = concepto;\n        this.formaDePago = formaDePago;\n    }\n\n    public double pagar() {\n        return valor;\n    }\n}\n\nclass FormaDePago {\n    \n}\n\" data-lang=\"javascript\">\n        <div class=\"code-block-header\">\n          <span class=\"code-block-title\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"4 17 10 11 4 5\"></polyline><line x1=\"12\" y1=\"19\" x2=\"20\" y2=\"19\"></line></svg>\n            Bloque de Código\n          </span>\n          <div class=\"code-block-actions\">\n            <select class=\"code-block-lang-select\" title=\"Seleccionar lenguaje\">\n              <option value=\"javascript\" selected=\"\">JavaScript</option>\n              <option value=\"python\">Python</option>\n              <option value=\"java\">Java</option>\n              <option value=\"c_cpp\">C / C++</option>\n              <option value=\"html\">HTML</option>\n              <option value=\"css\">CSS</option>\n              <option value=\"json\">JSON</option>\n              <option value=\"sql\">SQL</option>\n              <option value=\"markdown\">Markdown</option>\n            </select>\n            <button type=\"button\" class=\"code-block-delete-btn\" title=\"Eliminar bloque\">\n              <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"3 6 5 6 21 6\"></polyline><path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path></svg>\n            </button>\n          </div>\n        </div>\n        <div id=\"ace-1794875172341\" class=\"inline-ace-editor ace_editor ace_hidpi ace-tomorrow-night ace_dark ace_focus\" data-code=\"I'm stuck on how to do part 2.\n\nThis is what I've done for now: &quot;import java.util.List;\n\nabstract class Dependencia {\n    private String nombre;\n\n    public Dependencia(String nombre) {\n        this.nombre = nombre;\n    }\n\n    abstract double costo();\n}\n\nclass Oficina extends Dependencia {\n    public Oficina(String nombre) {\n        super(nombre);\n    }\n\n    private List&lt;Empleado&gt; empleados;\n\n    @Override\n    public double costo() {\n        return gastoLimpieza() + gastoEnergia() + gastoEmpleados();\n    }\n\n    private double gastoLimpieza() {\n        return 100.0;\n    }\n\n    private double gastoEnergia() {\n        return 200.0;\n    }\n\n    private double gastoEmpleados() {\n        return empleados.stream().mapToDouble(Empleado::salario).sum();\n    }\n\n    public void agregarEmpleado(Empleado empleado) {\n        empleados.add(empleado);\n    }\n\n    public List&lt;Empleado&gt; getEmpleados() {\n        return empleados;\n    }\n}\n\nclass Departamento extends Dependencia {\n    private List&lt;Dependencia&gt; dependencias;\n    private List&lt;GastosDepartamentales&gt; gastosDepartamentales;\n    \n    public Departamento(String nombre, List&lt;Dependencia&gt; dependencias) {\n        super(nombre);\n        this.dependencias = dependencias;\n    }\n\n    @Override\n    public double costo() {\n        return costoDependencias() + gastosDepartamentales();\n    }\n\n    public double costoDependencias() {\n        return dependencias.stream().mapToDouble(Dependencia::costo).sum();\n    }\n\n    public double gastosDepartamentales() {\n        return gastosDepartamentales.stream().mapToDouble(GastosDepartamentales::pagar).sum();\n    }\n\n    public void agregarGastoDepartamental(GastosDepartamentales g) {\n        gastosDepartamentales.add(g);\n    }\n}\n\n\nclass Empleado {\n    private String nombre;\n    private String edad;\n    private Double precioBase;\n    private Double porcentajeAportes;\n\n    public Empleado(String nombre, String edad, Double precioBase, Double porcentajeAportes) {\n        this.nombre = nombre;\n        this.edad = edad;\n        this.precioBase = precioBase;\n        this.porcentajeAportes = porcentajeAportes;\n    }\n\n    public double salario() {\n        return precioBase; //TODO: No entiendo la consigna\n    }\n}\n\nclass GastosDepartamentales {\n    private double valor;\n    private String concepto;\n    private FormaDePago formaDePago;\n\n    public GastosDepartamentales(double valor, String concepto, FormaDePago formaDePago) {\n        this.valor = valor;\n        this. concepto = concepto;\n        this.formaDePago = formaDePago;\n    }\n\n    public double pagar() {\n        return valor;\n    }\n}\n\nclass FormaDePago {\n    \n}\n\" data-lang=\"javascript\" data-initialized=\"true\" style=\"height: 760px; min-height: 60px; position: relative; font-size: 14px; font-family: &quot;JetBrains Mono&quot;, Consolas, Monaco, monospace;\"><textarea class=\"ace_text-input\" wrap=\"off\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\" aria-haspopup=\"false\" aria-autocomplete=\"both\" role=\"textbox\" aria-label=\"Cursor at row 112\" style=\"opacity: 0; height: 19px; width: 1px; transform: translate(79px, 741px);\"></textarea><div class=\"ace_gutter\" aria-hidden=\"true\" style=\"left: 0px; width: 59px;\"><div class=\"ace_layer ace_gutter-layer ace_folding-enabled\" style=\"height: 1e+06px; transform: translate(0px, -1843px); width: 59px;\